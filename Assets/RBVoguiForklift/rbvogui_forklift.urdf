	<!-- BASKET -->
	<!-- ===================================================================== -->
	<joint name="compact_forklift_basket_chassis_closed_livox_supports_joint" type="fixed">
		<origin rpy="0 0 0" xyz="0.027732 0 0.2445"/>
		<parent link="compact_forklift_chassis_link"/>
		<child link="compact_forklift_basket_root_link"/>
	</joint>
	<link name="compact_forklift_basket_root_link">
		<visual>
			<geometry>
				<mesh filename="package://robot_rbvogui_base/meshes/basket/basket_sensors.stl" scale="1.0 1.0 1.0"/>
			</geometry>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</visual>
		<collision>
			<geometry>
				<mesh filename="package://robot_rbvogui_base/meshes/basket/basket_sensors.stl" scale="1.0 1.0 1.0"/>
			</geometry>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</collision>
		<inertial>
			<mass value="0.01"/>
			<inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</inertial>
	</link>
	<!-- ===================================================================== -->
	<!-- FORK MOCKUP -->
	<!-- ===================================================================== -->
	<joint name="compact_forklift_fork_root_joint" type="prismatic">
		<origin rpy="0 0 0" xyz="0.618842 0 -0.09050000000000001"/>
		<parent link="compact_forklift_base_link"/>
		<child link="compact_forklift_fork_root_link"/>
		<axis xyz="0 0 1"/>
		<dynamics damping="10.0" friction="1.0"/>
		<limit effort="20000.0" lower="-0.005" upper="0.2" velocity="0.04"/>
	</joint>
	<link name="compact_forklift_fork_root_link">
		<visual>
			<geometry>
				<mesh filename="package://robotics_description/meshes/extras/forks/fork_mockup/fork_mockup.stl" scale="1.0 1.0 1.0"/>
			</geometry>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</visual>
		<collision>
			<geometry>
				<mesh filename="package://robotics_description/meshes/extras/forks/fork_mockup/fork_mockup.stl" scale="1.0 1.0 1.0"/>
			</geometry>
